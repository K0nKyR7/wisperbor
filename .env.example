# Токен Telegram-бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Провайдер распознавания: groq (рекомендуется, бесплатный и быстрый) или openai
STT_PROVIDER=groq

# Бесплатный ключ от Groq Console (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Модель для Groq: whisper-large-v3 или whisper-large-v3-turbo
GROQ_MODEL=whisper-large-v3-turbo

# Ключ OpenAI (заполнять, только если STT_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
